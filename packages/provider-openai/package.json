{
  "name": "@vasuagent/provider-openai",
  "version": "0.1.0",
  "description": "OpenAI provider adapter for VasuAgent SDK",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vasuagent/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
