{
  "name": "@vasuagent/core",
  "version": "0.1.0",
  "description": "Provider-independent runtime for reliable TypeScript AI agents",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
