{
  "name": "heybabyagent",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vasuagent/playground dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "example:basic": "tsx examples/basic-agent/index.ts",
    "example:tools": "tsx examples/tool-agent/index.ts",
    "example:handoff": "tsx examples/multi-agent-handoff/index.ts",
    "example:structured": "tsx examples/structured-output/index.ts",
    "example:memory": "tsx examples/persistent-memory/index.ts",
    "example:approval": "tsx examples/approval-guardrail/index.ts",
    "example:streaming": "tsx examples/streaming-agent/index.ts"
  },
  "devDependencies": {
    "@vasuagent/core": "workspace:*",
    "@types/node": "^26.2.0",
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  }
}
